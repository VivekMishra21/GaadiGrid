{
  "expo": {
    "name": "GaadiGrid",
    "slug": "gaadigrid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gaadigrid",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gaadigrid.app"
    },
    "android": {
      "package": "com.gaadigrid.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
