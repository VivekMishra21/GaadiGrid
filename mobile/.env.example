# Copy to .env and fill in for your environment. Read via app.config.js / expo-constants.
# Never commit the real .env file.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_MAPS_PROVIDER=google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAPPLS_API_KEY=

# GaadiGrid website (stores the Help & Contact and Partner With Us forms; also hosts Privacy/Terms pages)
EXPO_PUBLIC_WEBSITE_BASE_URL=http://localhost:3000
