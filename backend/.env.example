# Copy to .env and fill in real values for your environment.
# Never commit the real .env file.

ENVIRONMENT=development

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg://gaadigrid:gaadigrid_dev@localhost:5432/gaadigrid

# --- Redis (OTPs, caching, rate limits, live queue data) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---
# dev = logs OTP to server console / returns it in the API response (non-production only)
# msg91 / twilio = real SMS providers (not yet implemented, add credentials when integrating)
OTP_PROVIDER=dev
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5

SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# --- Seed admin (development only) ---
ADMIN_SEED_PHONE=+919999999999
ADMIN_SEED_EMAIL=admin@gaadigrid.dev

# --- Payments (Razorpay) ---
# dev = simulated payments/refunds, no real gateway call, real HMAC signature
#       verification against DEV_PAYMENT_WEBHOOK_SECRET (not skipped in dev mode)
# razorpay = real gateway (order creation/refunds not implemented yet — see
#            app/integrations/payments.py::RazorpayAdapter)
PAYMENT_PROVIDER=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEV_PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
DEFAULT_COMMISSION_RATE=0.15

# --- Object storage (S3-compatible) for documents/media ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

# --- Maps ---
MAPS_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# --- Weather ---
WEATHER_PROVIDER=dev
WEATHER_API_KEY=

# --- Push notifications ---
PUSH_PROVIDER=dev
FCM_SERVER_KEY=
EXPO_ACCESS_TOKEN=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# --- Queue reporting (Phase 2) ---
QUEUE_REPORT_EXPIRE_MINUTES=45
QUEUE_REPORT_COOLDOWN_SECONDS=120
QUEUE_REPORT_VERIFIED_PARTNER_WEIGHT=3.0
QUEUE_REPORT_MAX_DISTANCE_KM=2.0
QUEUE_REPORT_FLAG_THRESHOLD=2
DEFAULT_STATION_SEARCH_RADIUS_KM=10.0
MAX_STATION_SEARCH_RADIUS_KM=50.0
